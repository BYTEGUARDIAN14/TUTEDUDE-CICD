pipeline {
agent any

```
environment {
    APP_DIR = '/home/ubuntu/TUTEDUDE-CICD/flask-app'
    VENV_DIR = '/home/ubuntu/TUTEDUDE-CICD/flask-app/venv'
}

stages {

    stage('Checkout') {
        steps {

            echo 'Pulling latest code from GitHub...'

            git branch: 'main',
                url: 'https://github.com/BYTEGUARDIAN14/TUTEDUDE-CICD.git'
        }
    }

    stage('Install Dependencies') {
        steps {

            echo 'Installing Python dependencies...'

            sh '''
                cd ${APP_DIR}

                python3 -m venv venv

                ${VENV_DIR}/bin/pip install --upgrade pip

                ${VENV_DIR}/bin/pip install -r requirements.txt
            '''
        }
    }

    stage('Test') {
        steps {

            echo 'Running tests...'

            sh '''
                cd ${APP_DIR}

                ${VENV_DIR}/bin/python -m pytest tests/ -v || echo "No tests found, skipping"
            '''
        }
    }

    stage('Deploy') {
        steps {

            echo 'Restarting Flask app with PM2...'

            sh '''
                pm2 describe flask-app > /dev/null 2>&1 && \
                pm2 restart flask-app || \
                pm2 start "${APP_DIR}/venv/bin/python app.py" --name flask-app

                pm2 save
            '''
        }
    }
}

post {

    success {
        echo 'Flask deployment successful!'
    }

    failure {
        echo 'Flask deployment FAILED!'
    }
}
```

}
